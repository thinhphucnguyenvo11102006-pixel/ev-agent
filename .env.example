# E.V. Agent Environment Variables
# Copy this file to .env and fill in your API keys

# === Primary LLM (OpenRouter / DeepSeek) ===
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-001
DEEPSEEK_API_KEY=

# === Optional Fallback LLMs ===
GROQ_API_KEY=
GEMINI_API_KEY=

# === Model Settings ===
DEEPSEEK_MODEL=deepseek-chat
WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8

# === TTS ===
DEFAULT_TTS_ENGINE=edge
EDGE_TTS_VOICE=vi-VN-HoaiMyNeural

# === Activation ===
ACTIVATION_MODE=hybrid
HOTKEY=ctrl+space
WAKE_WORD=hey ev
